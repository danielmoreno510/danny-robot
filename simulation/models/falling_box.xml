<mujoco model="Danny Falling Box">

  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <global
      azimuth="120"
      elevation="-20"
      offwidth="1920"
      offheight="1080"
    />
  </visual>

  <worldbody>

    <!-- Iluminación -->
    <light pos="0 0 3" dir="0 0 -1"/>

    <!-- Suelo -->
    <geom
      name="floor"
      type="plane"
      size="2 2 0.1"
      rgba="0.7 0.7 0.7 1"
    />

    <!-- Primer cuerpo físico de Danny -->
    <body name="robot_body" pos="0 0 1">

      <freejoint/>

      <geom
        name="body"
        type="box"
        size="0.1 0.1 0.1"
        mass="1"
        rgba="0.1 0.4 0.9 1"
      />

    </body>

  </worldbody>

</mujoco>