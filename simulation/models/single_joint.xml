<mujoco model="H1 Single Joint">

  <compiler angle="degree"/>

  <option
    timestep="0.002"
    gravity="0 0 -9.81"
  />

  <visual>
    <global
      azimuth="120"
      elevation="-20"
      offwidth="1920"
      offheight="1080"
    />
  </visual>

  <worldbody>

    <!-- Iluminación -->
    <light
      pos="0 0 3"
      dir="0 0 -1"
    />

    <!-- Suelo -->
    <geom
      name="floor"
      type="plane"
      size="2 2 0.1"
      rgba="0.7 0.7 0.7 1"
    />

    <!-- Soporte fijo -->
    <body name="joint_support" pos="0 0 1">

      <geom
        name="support"
        type="box"
        size="0.15 0.15 0.05"
        rgba="0.3 0.3 0.3 1"
      />

      <!-- Segmento articulado -->
      <body name="robot_segment" pos="0 0 -0.05">

        <joint
          name="joint_1"
          type="hinge"
          axis="0 1 0"
          range="-90 90"
          limited="true"
          damping="0.5"
        />

        <geom
          name="segment"
          type="capsule"
          fromto="0 0 0 0 0 -0.4"
          size="0.04"
          mass="1"
          rgba="0.1 0.4 0.9 1"
        />

      </body>

    </body>

  </worldbody>

  <!-- Motor de posición -->
  <actuator>

    <position
      name="joint_1_motor"
      joint="joint_1"
      kp="5"
      kv="5"
      ctrlrange="-1.5708 1.5708"
      ctrllimited="true"
    />

  </actuator>

</mujoco>