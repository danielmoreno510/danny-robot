<mujoco model="Danny danny_humanoid">
  <compiler angle="radian"/>

  <option integrator="implicitfast"/>

  <visual>
    <global azimuth="150" elevation="-15" offwidth="1920" offheight="1080"/>
  </visual>

  <worldbody>
    <geom name="floor" size="2 2 0.1" type="plane" rgba="0.7 0.7 0.7 1"/>
    <light pos="0 0 3"/>
    <body name="pelvis" pos="0 0 0.4">
      <joint name="pelvis_free" type="free"/>
      <geom name="pelvis_geom" size="0.06 0.1 0.05" type="box" rgba="0.3 0.3 0.3 1" mass="2"/>
      <site name="imu_site" size="0.01" rgba="0 0 0 0"/>
      <body name="waist" pos="0 0 0.04">
        <joint name="waist_yaw_joint" range="-0.7854 0.7854" armature="0.01" damping="0.5" limited="true"/>
        <geom name="waist_geom" size="0.03 0.05 0.02" type="box" rgba="0.3 0.3 0.3 1" mass="0.2"/>
        <body name="torso">
          <joint name="waist_pitch_joint" range="-0.2618 0.7854" armature="0.01" damping="0.5" axis="0 1 0" limited="true"/>
          <geom name="torso_geom" size="0.06 0.1 0.07" pos="0 0 0.07" type="box" rgba="0.8 0.8 0.85 1" mass="2.8"/>
          <geom name="arm_ballast" size="0.04 0.14 0.05" pos="0 0 0.05" type="box" contype="0" conaffinity="0" rgba="0.8 0.3 0.3 0.4" mass="1.67"/>
          <geom name="head_ballast" size="0.045" pos="0 0 0.205" contype="0" conaffinity="0" rgba="0.8 0.3 0.3 0.4" mass="0.39"/>
        </body>
      </body>
      <body name="left_thigh" pos="0 0.07 -0.05">
        <joint name="left_hip_yaw_joint" range="-0.6981 0.6981" armature="0.01" damping="0.5" limited="true"/>
        <joint name="left_hip_roll_joint" range="-0.5236 0.5236" armature="0.01" damping="0.5" axis="1 0 0" limited="true"/>
        <joint name="left_hip_pitch_joint" range="-1.5708 1.5708" armature="0.01" damping="0.5" axis="0 1 0" limited="true"/>
        <geom name="left_thigh_geom" size="0.025 0.08" pos="0 0 -0.08" type="capsule" rgba="0.1 0.4 0.9 1" mass="1"/>
        <body name="left_shin" pos="0 0 -0.16">
          <joint name="left_knee_joint" range="0 2.2689" armature="0.01" damping="0.5" axis="0 1 0" limited="true"/>
          <geom name="left_shin_geom" size="0.025 0.08" pos="0 0 -0.08" type="capsule" rgba="0.1 0.7 0.5 1" mass="0.77"/>
          <body name="left_foot" pos="0 0 -0.16">
            <joint name="left_ankle_pitch_joint" range="-1.1345 0.7854" armature="0.01" damping="0.5" axis="0 1 0" limited="true"/>
            <joint name="left_ankle_roll_joint" range="-0.5236 0.5236" armature="0.01" damping="0.5" axis="1 0 0" limited="true"/>
            <geom name="left_foot_geom" size="0.07 0.04 0.01" pos="0 0 -0.03" type="box" rgba="0.9 0.5 0.1 1" mass="0.2"/>
            <site name="left_sole_site" size="0.01" pos="0 0 -0.04" rgba="0 0 0 0"/>
            <site name="left_touch_site" size="0.075 0.045 0.015" pos="0 0 -0.03" type="box" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>
      <body name="right_thigh" pos="0 -0.07 -0.05">
        <joint name="right_hip_yaw_joint" range="-0.6981 0.6981" armature="0.01" damping="0.5" limited="true"/>
        <joint name="right_hip_roll_joint" range="-0.5236 0.5236" armature="0.01" damping="0.5" axis="1 0 0" limited="true"/>
        <joint name="right_hip_pitch_joint" range="-1.5708 1.5708" armature="0.01" damping="0.5" axis="0 1 0" limited="true"/>
        <geom name="right_thigh_geom" size="0.025 0.08" pos="0 0 -0.08" type="capsule" rgba="0.1 0.4 0.9 1" mass="1"/>
        <body name="right_shin" pos="0 0 -0.16">
          <joint name="right_knee_joint" range="0 2.2689" armature="0.01" damping="0.5" axis="0 1 0" limited="true"/>
          <geom name="right_shin_geom" size="0.025 0.08" pos="0 0 -0.08" type="capsule" rgba="0.7 0.5 0.1 1" mass="0.77"/>
          <body name="right_foot" pos="0 0 -0.16">
            <joint name="right_ankle_pitch_joint" range="-1.1345 0.7854" armature="0.01" damping="0.5" axis="0 1 0" limited="true"/>
            <joint name="right_ankle_roll_joint" range="-0.5236 0.5236" armature="0.01" damping="0.5" axis="1 0 0" limited="true"/>
            <geom name="right_foot_geom" size="0.07 0.04 0.01" pos="0 0 -0.03" type="box" rgba="0.9 0.5 0.1 1" mass="0.2"/>
            <site name="right_sole_site" size="0.01" pos="0 0 -0.04" rgba="0 0 0 0"/>
            <site name="right_touch_site" size="0.075 0.045 0.015" pos="0 0 -0.03" type="box" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="pelvis" body2="left_thigh"/>
    <exclude body1="pelvis" body2="right_thigh"/>
    <exclude body1="pelvis" body2="torso"/>
  </contact>

  <actuator>
    <general name="left_hip_yaw_motor" joint="left_hip_yaw_joint" ctrlrange="-0.6981 0.6981" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -1.68"/>
    <general name="left_hip_roll_motor" joint="left_hip_roll_joint" ctrlrange="-0.5236 0.5236" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -4.83"/>
    <general name="left_hip_pitch_motor" joint="left_hip_pitch_joint" ctrlrange="-1.5708 1.5708" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -4.84"/>
    <general name="left_knee_motor" joint="left_knee_joint" ctrlrange="-0.0873 2.2689" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -2.53"/>
    <general name="left_ankle_pitch_motor" joint="left_ankle_pitch_joint" ctrlrange="-1.1345 0.7854" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -9.1"/>
    <general name="left_ankle_roll_motor" joint="left_ankle_roll_joint" ctrlrange="-0.5236 0.5236" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -9.1"/>
    <general name="right_hip_yaw_motor" joint="right_hip_yaw_joint" ctrlrange="-0.6981 0.6981" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -1.68"/>
    <general name="right_hip_roll_motor" joint="right_hip_roll_joint" ctrlrange="-0.5236 0.5236" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -4.83"/>
    <general name="right_hip_pitch_motor" joint="right_hip_pitch_joint" ctrlrange="-1.5708 1.5708" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -4.84"/>
    <general name="right_knee_motor" joint="right_knee_joint" ctrlrange="-0.0873 2.2689" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -2.53"/>
    <general name="right_ankle_pitch_motor" joint="right_ankle_pitch_joint" ctrlrange="-1.1345 0.7854" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -9.1"/>
    <general name="right_ankle_roll_motor" joint="right_ankle_roll_joint" ctrlrange="-0.5236 0.5236" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -9.1"/>
    <general name="waist_yaw_motor" joint="waist_yaw_joint" ctrlrange="-0.7854 0.7854" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -3"/>
    <general name="waist_pitch_motor" joint="waist_pitch_joint" ctrlrange="-0.2618 0.7854" ctrllimited="true" forcelimited="true" forcerange="-20 20" input="pos" biastype="affine" gainprm="100" biasprm="0 -100 -3.75"/>
  </actuator>

  <sensor>
    <framequat objtype="site" objname="imu_site" name="pelvis_quat"/>
    <framepos objtype="site" objname="imu_site" name="pelvis_pos"/>
    <jointpos joint="left_hip_yaw_joint" name="left_hip_yaw_pos"/>
    <jointpos joint="left_hip_roll_joint" name="left_hip_roll_pos"/>
    <jointpos joint="left_hip_pitch_joint" name="left_hip_pitch_pos"/>
    <jointpos joint="left_knee_joint" name="left_knee_pos"/>
    <jointpos joint="left_ankle_pitch_joint" name="left_ankle_pitch_pos"/>
    <jointpos joint="left_ankle_roll_joint" name="left_ankle_roll_pos"/>
    <jointpos joint="right_hip_yaw_joint" name="right_hip_yaw_pos"/>
    <jointpos joint="right_hip_roll_joint" name="right_hip_roll_pos"/>
    <jointpos joint="right_hip_pitch_joint" name="right_hip_pitch_pos"/>
    <jointpos joint="right_knee_joint" name="right_knee_pos"/>
    <jointpos joint="right_ankle_pitch_joint" name="right_ankle_pitch_pos"/>
    <jointpos joint="right_ankle_roll_joint" name="right_ankle_roll_pos"/>

    <actuatorfrc actuator="left_hip_yaw_motor" name="left_hip_yaw_torque"/>

    <actuatorfrc actuator="left_hip_roll_motor" name="left_hip_roll_torque"/>

    <actuatorfrc actuator="left_hip_pitch_motor" name="left_hip_pitch_torque"/>

    <actuatorfrc actuator="left_knee_motor" name="left_knee_torque"/>

    <actuatorfrc actuator="left_ankle_pitch_motor" name="left_ankle_pitch_torque"/>

    <actuatorfrc actuator="left_ankle_roll_motor" name="left_ankle_roll_torque"/>

    <actuatorfrc actuator="right_hip_yaw_motor" name="right_hip_yaw_torque"/>

    <actuatorfrc actuator="right_hip_roll_motor" name="right_hip_roll_torque"/>

    <actuatorfrc actuator="right_hip_pitch_motor" name="right_hip_pitch_torque"/>

    <actuatorfrc actuator="right_knee_motor" name="right_knee_torque"/>

    <actuatorfrc actuator="right_ankle_pitch_motor" name="right_ankle_pitch_torque"/>

    <actuatorfrc actuator="right_ankle_roll_motor" name="right_ankle_roll_torque"/>
    <jointpos joint="waist_yaw_joint" name="waist_yaw_pos"/>

    <actuatorfrc actuator="waist_yaw_motor" name="waist_yaw_torque"/>
    <jointpos joint="waist_pitch_joint" name="waist_pitch_pos"/>

    <actuatorfrc actuator="waist_pitch_motor" name="waist_pitch_torque"/>
    <touch site="left_touch_site" name="left_foot_force"/>
    <touch site="right_touch_site" name="right_foot_force"/>
  </sensor>
</mujoco>
