<mujoco model="Danny">

  <!--
    Robot Danny (etapas 13 y 20): 70 cm y 8 kg, con torso provisional.

    Dimensiones y masas PROVISIONALES, hasta elegir motores (etapa 31):
      suelo-tobillo 4 cm, tibia 16 cm, muslo 16 cm, cadera-pelvis 5 cm,
      pelvis 10 cm de alto, torso 24 cm. Pies de 14 x 8 cm, caderas a +-7 cm.
      Masas [kg]: torso 4, pelvis 1,2, muslo 0,7, tibia 0,5, pie 0,2.

    La pelvis tiene freejoint: solo la sostienen las piernas. Las dos piernas
    tienen los mismos ejes y signos que leg_6dof.xml (no son espejo).
  -->
  <compiler angle="radian"/>

  <!-- implicitfast por la misma razón que en leg_6dof.xml -->
  <option
    timestep="0.002"
    gravity="0 0 -9.81"
    integrator="implicitfast"
  />

  <visual>
    <global
      azimuth="150"
      elevation="-15"
      offwidth="1920"
      offheight="1080"
    />
  </visual>

  <default>
    <!--
      armature: inercia del motor reflejada por la reductora (provisional).
      Sin ella, los tobillos son tan ligeros que resuenan a 12 Hz con el
      contacto: Danny vibra y los pies se desplazan.
    -->
    <joint
      type="hinge"
      damping="0.5"
      armature="0.01"
      limited="true"
    />
    <!-- Por defecto nada choca: solo pies y suelo activan el contacto -->
    <geom
      type="capsule"
      size="0.025"
      rgba="0.1 0.4 0.9 1"
      contype="0"
      conaffinity="0"
    />
    <position
      kp="100"
      ctrllimited="true"
      forcelimited="true"
      forcerange="-20 20"
    />
    <!-- Pie plano de leg_6dof.xml: planta 4 cm bajo el tobillo -->
    <default class="foot">
      <geom
        type="box"
        pos="0 0 -0.03"
        size="0.07 0.04 0.01"
        mass="0.2"
        rgba="0.9 0.5 0.1 1"
        contype="1"
        conaffinity="1"
      />
    </default>
  </default>

  <worldbody>

    <light
      pos="0 0 3"
      dir="0 0 -1"
    />

    <geom
      name="floor"
      type="plane"
      size="2 2 0.1"
      rgba="0.7 0.7 0.7 1"
      contype="1"
      conaffinity="1"
      friction="1 0.005 0.0001"
    />

    <!-- La pose inicial de la pelvis la fija el script (ver biped_control.py) -->
    <body name="pelvis" pos="0 0 0.4">

      <freejoint name="pelvis_free"/>

      <geom
        name="pelvis_geom"
        type="box"
        size="0.06 0.10 0.05"
        mass="1.2"
        rgba="0.3 0.3 0.3 1"
      />

      <!-- Torso provisional: sin brazos ni articulación, solo su masa y su altura -->
      <geom
        name="torso_geom"
        type="box"
        pos="0 0 0.17"
        size="0.06 0.10 0.12"
        mass="4"
        rgba="0.8 0.8 0.85 1"
      />

      <site name="imu_site" size="0.01" rgba="0 0 0 0"/>

      <!-- Pierna izquierda (+y) -->
      <body name="left_thigh" pos="0 0.07 -0.05">
          <joint name="left_hip_yaw_joint" axis="0 0 1" range="-0.6981 0.6981"/>  <!-- ±40° -->
          <joint name="left_hip_roll_joint" axis="1 0 0" range="-0.5236 0.5236"/>  <!-- ±30° -->
          <joint name="left_hip_pitch_joint" axis="0 1 0" range="-1.5708 1.5708"/>  <!-- ±90° -->
        <geom name="left_thigh_geom" fromto="0 0 0 0 0 -0.16" mass="0.7"/>

        <body name="left_shin" pos="0 0 -0.16">
          <joint name="left_knee_joint" axis="0 1 0" range="0 2.2689"/>  <!-- 0° .. 130° -->
          <geom name="left_shin_geom" fromto="0 0 0 0 0 -0.16" mass="0.5" rgba="0.1 0.7 0.5 1"/>

          <body name="left_foot" pos="0 0 -0.16">
              <joint name="left_ankle_pitch_joint" axis="0 1 0" range="-1.1345 0.7854"/>  <!-- -65° .. 45° -->
              <joint name="left_ankle_roll_joint" axis="1 0 0" range="-0.5236 0.5236"/>  <!-- ±30° -->
            <geom name="left_foot_geom" class="foot"/>
            <site name="left_sole_site" pos="0 0 -0.04" size="0.01" rgba="0 0 0 0"/>
            <site name="left_touch_site" type="box" pos="0 0 -0.03" size="0.075 0.045 0.015" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>

      <!-- Pierna derecha (-y) -->
      <body name="right_thigh" pos="0 -0.07 -0.05">
          <joint name="right_hip_yaw_joint" axis="0 0 1" range="-0.6981 0.6981"/>  <!-- ±40° -->
          <joint name="right_hip_roll_joint" axis="1 0 0" range="-0.5236 0.5236"/>  <!-- ±30° -->
          <joint name="right_hip_pitch_joint" axis="0 1 0" range="-1.5708 1.5708"/>  <!-- ±90° -->
        <geom name="right_thigh_geom" fromto="0 0 0 0 0 -0.16" mass="0.7"/>

        <body name="right_shin" pos="0 0 -0.16">
          <joint name="right_knee_joint" axis="0 1 0" range="0 2.2689"/>  <!-- 0° .. 130° -->
          <geom name="right_shin_geom" fromto="0 0 0 0 0 -0.16" mass="0.5" rgba="0.7 0.5 0.1 1"/>

          <body name="right_foot" pos="0 0 -0.16">
              <joint name="right_ankle_pitch_joint" axis="0 1 0" range="-1.1345 0.7854"/>  <!-- -65° .. 45° -->
              <joint name="right_ankle_roll_joint" axis="1 0 0" range="-0.5236 0.5236"/>  <!-- ±30° -->
            <geom name="right_foot_geom" class="foot"/>
            <site name="right_sole_site" pos="0 0 -0.04" size="0.01" rgba="0 0 0 0"/>
            <site name="right_touch_site" type="box" pos="0 0 -0.03" size="0.075 0.045 0.015" rgba="0 0 0 0"/>
          </body>
        </body>
      </body>

    </body>

  </worldbody>

  <!--
    kp = 100 (default). kv = 2 * 0.8 * sqrt(kp * (I + armature)), con I medida
    con mj_fullM y la pierna recta [kg·m²]: hip_yaw 0.00080, hip_roll 0.06185,
    hip_pitch 0.06207, knee 0.01240, ankle_pitch 0.00051, ankle_roll 0.00029.
    Excepto los tobillos: de pie sostienen todo el cuerpo (I ~ 1,3 kg·m² sobre los
    dos tobillos, kp efectivo 200 - m g h), así que su kv se calcula para esa carga,
    con zeta ~ 0,6. Con el valor de la pierna colgando (1,6), zeta era 0,15 y el
    cuerpo rebotaba sobre los tobillos tras un empujón.
    Límite de ±20 N·m provisional.
  -->
  <actuator>

    <position name="left_hip_yaw_motor" joint="left_hip_yaw_joint" kv="1.66" ctrlrange="-0.6981 0.6981"/>
    <position name="left_hip_roll_motor" joint="left_hip_roll_joint" kv="4.3" ctrlrange="-0.5236 0.5236"/>
    <position name="left_hip_pitch_motor" joint="left_hip_pitch_joint" kv="4.3" ctrlrange="-1.5708 1.5708"/>
    <position name="left_knee_motor" joint="left_knee_joint" kv="2.4" ctrlrange="-0.0873 2.2689"/>
    <position name="left_ankle_pitch_motor" joint="left_ankle_pitch_joint" kv="8.5" ctrlrange="-1.1345 0.7854"/>
    <position name="left_ankle_roll_motor" joint="left_ankle_roll_joint" kv="8.5" ctrlrange="-0.5236 0.5236"/>

    <position name="right_hip_yaw_motor" joint="right_hip_yaw_joint" kv="1.66" ctrlrange="-0.6981 0.6981"/>
    <position name="right_hip_roll_motor" joint="right_hip_roll_joint" kv="4.3" ctrlrange="-0.5236 0.5236"/>
    <position name="right_hip_pitch_motor" joint="right_hip_pitch_joint" kv="4.3" ctrlrange="-1.5708 1.5708"/>
    <position name="right_knee_motor" joint="right_knee_joint" kv="2.4" ctrlrange="-0.0873 2.2689"/>
    <position name="right_ankle_pitch_motor" joint="right_ankle_pitch_joint" kv="8.5" ctrlrange="-1.1345 0.7854"/>
    <position name="right_ankle_roll_motor" joint="right_ankle_roll_joint" kv="8.5" ctrlrange="-0.5236 0.5236"/>

  </actuator>

  <sensor>

    <!-- IMU: orientación y posición de la pelvis -->
    <framequat name="pelvis_quat" objtype="site" objname="imu_site"/>
    <framepos name="pelvis_pos" objtype="site" objname="imu_site"/>

    <jointpos name="left_hip_yaw_pos" joint="left_hip_yaw_joint"/>
    <jointpos name="left_hip_roll_pos" joint="left_hip_roll_joint"/>
    <jointpos name="left_hip_pitch_pos" joint="left_hip_pitch_joint"/>
    <jointpos name="left_knee_pos" joint="left_knee_joint"/>
    <jointpos name="left_ankle_pitch_pos" joint="left_ankle_pitch_joint"/>
    <jointpos name="left_ankle_roll_pos" joint="left_ankle_roll_joint"/>

    <jointpos name="right_hip_yaw_pos" joint="right_hip_yaw_joint"/>
    <jointpos name="right_hip_roll_pos" joint="right_hip_roll_joint"/>
    <jointpos name="right_hip_pitch_pos" joint="right_hip_pitch_joint"/>
    <jointpos name="right_knee_pos" joint="right_knee_joint"/>
    <jointpos name="right_ankle_pitch_pos" joint="right_ankle_pitch_joint"/>
    <jointpos name="right_ankle_roll_pos" joint="right_ankle_roll_joint"/>

    <actuatorfrc name="left_hip_yaw_torque" actuator="left_hip_yaw_motor"/>
    <actuatorfrc name="left_hip_roll_torque" actuator="left_hip_roll_motor"/>
    <actuatorfrc name="left_hip_pitch_torque" actuator="left_hip_pitch_motor"/>
    <actuatorfrc name="left_knee_torque" actuator="left_knee_motor"/>
    <actuatorfrc name="left_ankle_pitch_torque" actuator="left_ankle_pitch_motor"/>
    <actuatorfrc name="left_ankle_roll_torque" actuator="left_ankle_roll_motor"/>

    <actuatorfrc name="right_hip_yaw_torque" actuator="right_hip_yaw_motor"/>
    <actuatorfrc name="right_hip_roll_torque" actuator="right_hip_roll_motor"/>
    <actuatorfrc name="right_hip_pitch_torque" actuator="right_hip_pitch_motor"/>
    <actuatorfrc name="right_knee_torque" actuator="right_knee_motor"/>
    <actuatorfrc name="right_ankle_pitch_torque" actuator="right_ankle_pitch_motor"/>
    <actuatorfrc name="right_ankle_roll_torque" actuator="right_ankle_roll_motor"/>

    <!-- Fuerza normal del suelo sobre cada pie [N] -->
    <touch name="left_foot_force" site="left_touch_site"/>
    <touch name="right_foot_force" site="right_touch_site"/>

  </sensor>

</mujoco>
