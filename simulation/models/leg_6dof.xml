<mujoco model="Danny Leg 6DOF">

  <!--
    Pierna de 6 GDL con pie plano (experimento 9).

    Cambios respecto a leg_2dof_foot.xml:
      - Cadera de 3 ejes: yaw (z), roll (x), pitch (y). Los tres ejes se
        cruzan en un punto: son tres joints en el mismo body. Simplificación
        habitual; en un robot real cada motor va en su propio eslabón.
      - Tobillo de 2 ejes, ahora CON motor: pitch (y) y roll (x).
      - Pie plano (caja de 20 x 10 cm) en lugar de la esfera.
      - Restricción de igualdad "hold_pelvis" (desactivada por defecto):
        si se activa, sujeta la pelvis alta para mover la pierna en el aire.

    Ejes y signos (REP-103: x adelante, y izquierda, z arriba), todos con
    la regla de la mano derecha y el resto de articulaciones a cero:
      - hip_yaw     +  = la punta del pie gira a la izquierda (+y).
      - hip_roll    +  = el pie se va a la izquierda (+y).
      - hip_pitch   +  = extensión, el pie se va atrás (-x).
      - knee        +  = flexión, el pie se va atrás (-x).
      - ankle_pitch +  = punta del pie abajo (flexión plantar).
      - ankle_roll  +  = el borde izquierdo (+y) del pie sube.
    Sentadilla con el pie plano y bajo la cadera:
      hip_pitch = -knee / 2,  ankle_pitch = -knee / 2.

    Dimensiones y masas: DIDÁCTICAS, no son las definitivas de Danny.
  -->
  <compiler angle="radian"/>

  <!--
    implicitfast: integra el amortiguamiento de los motores (kv) de forma
    implícita. Con Euler (el defecto) la cadera se volvía inestable: con la
    cadera girada, una combinación yaw + roll (o yaw + pitch) hace girar la
    pierna sobre su propio eje, un modo con inercia diminuta (~0.002 kg·m²),
    y el kv calculado para roll/pitch (inercia ~0.22) pasa el límite de
    estabilidad kv·dt/I ≈ 2. Ver README, experimento 9.
  -->
  <option
    timestep="0.002"
    gravity="0 0 -9.81"
    integrator="implicitfast"
  />

  <visual>
    <global
      azimuth="120"
      elevation="-20"
      offwidth="1920"
      offheight="1080"
    />
  </visual>

  <default>
    <joint
      type="hinge"
      damping="0.5"
      limited="true"
    />
    <!-- Por defecto nada choca: solo pie y suelo activan el contacto -->
    <geom
      type="capsule"
      size="0.035"
      rgba="0.1 0.4 0.9 1"
      contype="0"
      conaffinity="0"
    />
    <position
      kp="100"
      ctrllimited="true"
      forcelimited="true"
      forcerange="-20 20"
    />
  </default>

  <worldbody>

    <light
      pos="0 0 3"
      dir="0 0 -1"
    />

    <geom
      name="floor"
      type="plane"
      size="2 2 0.1"
      rgba="0.7 0.7 0.7 1"
      contype="1"
      conaffinity="1"
      friction="1 0.005 0.0001"
    />

    <!-- La altura real de la pelvis la fija el script (ver analyze_leg_6dof.py) -->
    <body name="pelvis" pos="0 0 0.6">

      <!-- Solo sube y baja. qpos = desplazamiento respecto a z = 0.6 -->
      <joint
        name="pelvis_slide"
        type="slide"
        axis="0 0 1"
        range="-0.5 0.3"
        damping="0"
      />

      <geom
        name="pelvis_geom"
        type="box"
        size="0.12 0.08 0.05"
        mass="2"
        rgba="0.3 0.3 0.3 1"
      />

      <body name="thigh" pos="0 0 -0.05">

        <!-- El orden importa: primero yaw, luego roll, luego pitch -->
        <joint name="hip_yaw_joint"   axis="0 0 1" range="-0.6981 0.6981"/>  <!-- ±40° -->
        <joint name="hip_roll_joint"  axis="1 0 0" range="-0.5236 0.5236"/>  <!-- ±30° -->
        <joint name="hip_pitch_joint" axis="0 1 0" range="-1.5708 1.5708"/>  <!-- ±90° -->

        <geom
          name="thigh_geom"
          fromto="0 0 0 0 0 -0.25"
          mass="1"
        />

        <body name="shin" pos="0 0 -0.25">

          <!-- 0° .. 130° -->
          <joint name="knee_joint" axis="0 1 0" range="0 2.2689"/>

          <geom
            name="shin_geom"
            fromto="0 0 0 0 0 -0.25"
            mass="0.8"
            rgba="0.1 0.7 0.5 1"
          />

          <body name="foot" pos="0 0 -0.25">

            <joint name="ankle_pitch_joint" axis="0 1 0" range="-1.1345 0.7854"/>  <!-- -65° .. 45° -->
            <joint name="ankle_roll_joint"  axis="1 0 0" range="-0.5236 0.5236"/>  <!-- ±30° -->

            <!-- Planta a 4 cm bajo el tobillo, centrada bajo él -->
            <geom
              name="foot_geom"
              type="box"
              pos="0 0 -0.025"
              size="0.10 0.05 0.015"
              mass="0.3"
              rgba="0.9 0.5 0.1 1"
              contype="1"
              conaffinity="1"
            />

            <!-- Centro de la planta -->
            <site
              name="sole_site"
              pos="0 0 -0.04"
              size="0.01"
              rgba="0 0 0 0"
            />

            <!-- Zona del sensor de contacto: algo mayor que el pie -->
            <site
              name="foot_touch_site"
              type="box"
              pos="0 0 -0.025"
              size="0.105 0.055 0.02"
              rgba="0 0 0 0"
            />

          </body>

        </body>

      </body>

    </body>

  </worldbody>

  <!-- Pelvis sujeta a z = 0.6 + 0.2 = 0.8 m (pie a ~21 cm del suelo) -->
  <equality>
    <joint
      name="hold_pelvis"
      joint1="pelvis_slide"
      polycoef="0.2 0 0 0 0"
      active="false"
    />
  </equality>

  <!--
    kp = 100 en todos (default). kv elegido para zeta ~ 0.8 con la inercia
    articular de cada eje, medida con mj_fullM con la pierna recta:
      kv = 2 * zeta * sqrt(kp * I)   (ver README, experimento 9)
      hip_yaw 0.0023 · hip_roll 0.2249 · hip_pitch 0.2257 · knee 0.0424
      ankle_pitch 0.0012 · ankle_roll 0.0005   [kg·m²]
  -->
  <actuator>

    <position name="hip_yaw_motor"     joint="hip_yaw_joint"     kv="0.8" ctrlrange="-0.6981 0.6981"/>
    <position name="hip_roll_motor"    joint="hip_roll_joint"    kv="7.6" ctrlrange="-0.5236 0.5236"/>
    <position name="hip_pitch_motor"   joint="hip_pitch_joint"   kv="7.6" ctrlrange="-1.5708 1.5708"/>
    <!--
      Rodilla: el mando puede bajar a -5° aunque la articulación tope en 0°.
      Con la pierna recta y la cadera adelantada, la compensación de gravedad
      necesita un objetivo algo negativo; con ctrlrange="0 ..." se recortaba
      y la rodilla se doblaba 0,7°. El tope mecánico (range) sigue en 0°.
    -->
    <position name="knee_motor"        joint="knee_joint"        kv="3.3" ctrlrange="-0.0873 2.2689"/>
    <position name="ankle_pitch_motor" joint="ankle_pitch_joint" kv="0.6" ctrlrange="-1.1345 0.7854"/>
    <position name="ankle_roll_motor"  joint="ankle_roll_joint"  kv="0.3" ctrlrange="-0.5236 0.5236"/>

  </actuator>

  <sensor>

    <jointpos name="pelvis_height" joint="pelvis_slide"/>

    <jointpos name="hip_yaw_pos"     joint="hip_yaw_joint"/>
    <jointpos name="hip_roll_pos"    joint="hip_roll_joint"/>
    <jointpos name="hip_pitch_pos"   joint="hip_pitch_joint"/>
    <jointpos name="knee_pos"        joint="knee_joint"/>
    <jointpos name="ankle_pitch_pos" joint="ankle_pitch_joint"/>
    <jointpos name="ankle_roll_pos"  joint="ankle_roll_joint"/>

    <actuatorfrc name="hip_yaw_torque"     actuator="hip_yaw_motor"/>
    <actuatorfrc name="hip_roll_torque"    actuator="hip_roll_motor"/>
    <actuatorfrc name="hip_pitch_torque"   actuator="hip_pitch_motor"/>
    <actuatorfrc name="knee_torque"        actuator="knee_motor"/>
    <actuatorfrc name="ankle_pitch_torque" actuator="ankle_pitch_motor"/>
    <actuatorfrc name="ankle_roll_torque"  actuator="ankle_roll_motor"/>

    <!-- Fuerza normal del suelo sobre el pie [N] -->
    <touch name="foot_force" site="foot_touch_site"/>

  </sensor>

</mujoco>
